{
  "name": "grid-agentic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:netlify": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "listings:import": "tsx scripts/listings-import.ts",
    "db:generate:listings": "drizzle-kit generate --config drizzle-listings.config.ts",
    "projections:rebuild": "tsx scripts/projections-rebuild.ts",
    "assets:docs": "node scripts/copy-doc-assets.mjs",
    "predev": "node scripts/copy-doc-assets.mjs",
    "prebuild": "node scripts/copy-doc-assets.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "~1.2.0",
    "@node-rs/argon2": "~2.2.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "clsx": "~2.1.1",
    "drizzle-orm": "~0.45.4",
    "lucide-react": "~1.61.0",
    "mammoth": "^1.13.0",
    "next": "~16.4.2",
    "pdfjs-dist": "^6.5.438",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "server-only": "~0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "~0.5.11",
    "@netlify/plugin-nextjs": "~5.16.4",
    "@playwright/test": "~1.64.1",
    "@tailwindcss/postcss": "~4.3.3",
    "@types/node": "~22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "dotenv": "~18.0.8",
    "drizzle-kit": "~0.31.11",
    "eslint": "~9.39.5",
    "eslint-config-next": "~16.4.2",
    "tailwindcss": "~4.3.3",
    "tsx": "~4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "~5.0.5"
  }
}
