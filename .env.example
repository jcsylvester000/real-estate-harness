# Copy to .env.local (never commit it). On Netlify, set these under Site configuration > Environment variables.

# --- Database (Neon) ---
DATABASE_URL=            # pooled connection string (host contains "-pooler")
DATABASE_URL_UNPOOLED=   # same, without "-pooler" (used by npm run db:migrate)

# --- App ---
APP_SECRET=              # 32+ random characters
APP_ORIGIN=http://localhost:3000   # your site URL on Netlify, e.g. https://grid-agentic.netlify.app

# --- AI providers (add at least one key for real AI; the Demo provider works without keys) ---
HARNESS_PROVIDER=anthropic          # default provider: anthropic | openai | gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BUDGET_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_BUDGET_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1   # or OpenRouter, Groq, DeepSeek, Azure, Ollama...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro
GEMINI_BUDGET_MODEL=gemini-3.5-flash-lite
HARNESS_DEMO_PROVIDER=true          # set false to hide "Demo (no AI key)"

# --- Limits ---
GRID_DAILY_AI_CAP_PHP=300           # AI spend per person per Manila day (0 = no cap)
HARNESS_MAX_TOOL_STEPS=6
HARNESS_MAX_OUTPUT_TOKENS=1500
HARNESS_MAX_COST_PER_TURN_USD=0.25
HARNESS_HISTORY_TURNS=12
HARNESS_PROVIDER_TIMEOUT_MS=25000
USD_TO_PHP=63.5
GRID_BROKERAGE_NAME=GRID Property Ventures

# --- Third-party apps on other domains (space-separated https origins allowed in windows) ---
GRID_APP_ORIGINS=
